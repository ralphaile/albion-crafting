{
  "name": "@aoc/core",
  "version": "0.0.0",
  "description": "Crafting calculation engine: return rate, material cost, station fee, taxes, focus, profit and ranking. Pure TypeScript with no I/O.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@aoc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aoc/eslint-config": "workspace:*",
    "@aoc/typescript-config": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
