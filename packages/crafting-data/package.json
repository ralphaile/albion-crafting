{
  "name": "@aoc/crafting-data",
  "version": "0.0.0",
  "description": "Crafting data from the game files (ao-bin-dumps): recipes, item values, names, icons, locations and crafting bonuses.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@aoc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aoc/eslint-config": "workspace:*",
    "@aoc/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
