{
  "name": "@aoc/market-prices",
  "version": "0.0.0",
  "description": "Client for the Albion Online Data Project (AODP) API: live market prices and price history.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@aoc/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./test/fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aoc/eslint-config": "workspace:*",
    "@aoc/typescript-config": "workspace:*",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
